# =============================================================================
# La Brújula FM — Web · variables de entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Backend PocketBase (chat en vivo, analítica de oyentes y panel admin)
# -----------------------------------------------------------------------------
# URL pública de la instancia de PocketBase, con esquema y sin barra final.
#
# Se lee en DOS lugares:
#   · src/lib/radio-config.ts  → cliente PocketBase de la web (build-time,
#                                 por eso lleva el prefijo NEXT_PUBLIC_)
#   · src/app/api/pb-config/   → la sirve al panel admin en runtime
#
# Sin esta variable la web arranca igual, pero `hasChat` queda en false: la UI
# oculta el chat en vez de romperse, y el panel admin muestra un error claro.
#
# Nota: al ser NEXT_PUBLIC_ se inlinea en el bundle del navegador. En Coolify
# hay que definirla como variable de BUILD, no solo de runtime.
NEXT_PUBLIC_PB_URL=https://pb.tu-dominio.com
